{
    "version": "1.14.0-beta.17",
    "description": "The universal proxy platform.",
    "homepage": "https://sing-box.sagernet.org/",
    "license": "GPL-3.0-or-later",
    "depends": "Koolar/winsw",
    "suggest": {
        "Koolar/proxifyre-winsw": "A Windows SOCKS5 proxifier that leverages NDISAPI to transparently route TCP and UDP traffic on a per-application basis. It can be used together with sing-box to proxy applications that do not support SOCKS5 proxy natively."
    },
    "notes": [
        "sing-box is installed as a Windows service through WinSW.",
        "If you want to use TUN mode, please run the sing-box service with administrator privileges.",
        "Please set system proxy manually if you want to use."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/SagerNet/sing-box/releases/download/v1.14.0-beta.17/sing-box-1.14.0-beta.17-windows-amd64.zip",
            "hash": "8e9a841d75e5ce184bbd57f302a8228fdca8957842bd5ec494b0d1994334a53e",
            "extract_dir": "sing-box-1.14.0-beta.17-windows-amd64"
        },
        "32bit": {
            "url": "https://github.com/SagerNet/sing-box/releases/download/v1.14.0-beta.17/sing-box-1.14.0-beta.17-windows-386.zip",
            "hash": "1236ced76ba03b37be819bab73e3914b76dd83c2be2af0e0e78e8a17c9873595",
            "extract_dir": "sing-box-1.14.0-beta.17-windows-386"
        },
        "arm64": {
            "url": "https://github.com/SagerNet/sing-box/releases/download/v1.14.0-beta.17/sing-box-1.14.0-beta.17-windows-arm64.zip",
            "hash": "9fea9965f08f593b573549001cf53e5e0c0f2b104cb0bd551097715918c791f2",
            "extract_dir": "sing-box-1.14.0-beta.17-windows-arm64"
        }
    },
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\")) { New-Item -Path \"$persist_dir\" -ItemType Directory | Out-Null }",
        "if (!(Test-Path \"$persist_dir\\config.json\")) {",
        "   $utf8NoBom = New-Object System.Text.UTF8Encoding($false)",
        "   [System.IO.File]::WriteAllText(\"$persist_dir\\config.json\", \"{}`n\", $utf8NoBom)",
        "} elseif ([string]::IsNullOrWhiteSpace((Get-Content -Path \"$persist_dir\\config.json\" -Raw))) {",
        "   Write-Host",
        "   Write-Host \"Please add a config URL to sing-box.xml or manually place your config.json in the persist directory before starting.\" -ForegroundColor Red",
        "}",
        "if (!(Test-Path \"$persist_dir\\cache.db\")) { New-Item -Path \"$persist_dir\\cache.db\" -ItemType File | Out-Null }",
        "if (!(Test-Path \"$persist_dir\\sing-box.xml\")) {",
        "    Set-Content -Path \"$dir\\sing-box.xml\" -Encoding UTF8 -Value @'",
        "<service>",
        "    <id>sing-box</id>",
        "    <name>sing-box</name>",
        "    <description>The universal proxy platform.</description>",
        "    <executable>%BASE%\\sing-box.exe</executable>",
        "    <arguments>run -c \"%BASE%\\config.json\"</arguments>",
        "    <download from=\"\" to=\"%BASE%\\config.json\" />",
        "    <log mode=\"reset\"></log>",
        "    <onfailure action=\"restart\" delay=\"5 sec\" />",
        "</service>",
        "'@",
        "}"
    ],
    "post_install": [
        "$winswConfig = \"$dir\\sing-box.xml\"",
        "$postInstallScript = \"$dir\\_post_install.ps1\"",
        "Set-Content -Path $postInstallScript -Value @\"",
        "`$service = Get-Service -Name sing-box -ErrorAction SilentlyContinue",
        "if (`$null -eq `$service) {",
        "    Write-Host 'Service not found, installing sing-box as a service...' -ForegroundColor Yellow",
        "    winsw install '$winswConfig'",
        "} else {",
        "    Write-Host 'Service already exists, refreshing...' -ForegroundColor Yellow",
        "    winsw refresh '$winswConfig'",
        "}",
        "\"@",
        "Write-Host",
        "sudo powershell -NoProfile -ExecutionPolicy Bypass -File \"$postInstallScript\"",
        "Remove-Item \"$postInstallScript\" -ErrorAction SilentlyContinue",
        "Write-Host \"List of useful commands:\" -ForegroundColor Blue",
        "Write-Host \"winsw status '$winswConfig'\" -ForegroundColor Blue",
        "Write-Host \"winsw refresh '$winswConfig'\" -ForegroundColor Blue",
        "Write-Host \"winsw start '$winswConfig'\" -ForegroundColor Blue",
        "Write-Host \"winsw stop '$winswConfig'\" -ForegroundColor Blue",
        "Write-Host \"winsw restart '$winswConfig'\" -ForegroundColor Blue"
    ],
    "pre_uninstall": [
        "$preUninstallScript = \"$dir\\_pre_uninstall.ps1\"",
        "Set-Content -Path $preUninstallScript -Value @\"",
        "`$service = Get-Service -Name sing-box -ErrorAction SilentlyContinue",
        "if (`$null -ne `$service) {",
        "    Write-Host 'Stopping and uninstalling sing-box service...' -ForegroundColor Yellow",
        "    winsw stop '$dir\\sing-box.xml'",
        "    winsw uninstall '$dir\\sing-box.xml'",
        "}",
        "if (Test-Path '$dir\\tailscale') {",
        "    takeown /f '$dir\\tailscale' /r /d y | Out-Null",
        "    icacls '$dir\\tailscale' /reset /t /q",
        "    icacls '$dir\\tailscale' /grant '*S-1-5-32-545:(OI)(CI)F' /t /q",
        "}",
        "\"@",
        "Write-Host",
        "sudo powershell -NoProfile -ExecutionPolicy Bypass -File \"$preUninstallScript\"",
        "Remove-Item \"$preUninstallScript\" -ErrorAction SilentlyContinue"
    ],
    "bin": "sing-box.exe",
    "persist": [
        "config",
        "config.d",
        "config.json",
        "cache.db",
        "tailscale",
        "sing-box.xml"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/SagerNet/sing-box/releases",
        "jsonpath": "$[?(@.prerelease == true)].tag_name",
        "regex": "v(?<version>[\\w-.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/SagerNet/sing-box/releases/download/v$version/sing-box-$version-windows-amd64.zip",
                "extract_dir": "sing-box-$version-windows-amd64"
            },
            "32bit": {
                "url": "https://github.com/SagerNet/sing-box/releases/download/v$version/sing-box-$version-windows-386.zip",
                "extract_dir": "sing-box-$version-windows-386"
            },
            "arm64": {
                "url": "https://github.com/SagerNet/sing-box/releases/download/v$version/sing-box-$version-windows-arm64.zip",
                "extract_dir": "sing-box-$version-windows-arm64"
            }
        }
    }
}
